+    tl.feedImu(t0 + 5000000ll, gtsam::Vector3(0, 0, 9.81), gtsam::Vector3::Zero());
+    // Out-of-order sample: dropped and counted, never used with invented dt.
+    tl.feedImu(t0 + 1000000ll, gtsam::Vector3(0, 0, 9.81), gtsam::Vector3::Zero());
